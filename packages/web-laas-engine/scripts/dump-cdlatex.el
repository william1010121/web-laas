(require 'json)
(load (expand-file-name "~/.config/emacs/.local/straight/repos/cdlatex/cdlatex.el") nil t)
(defun dump--val (v)
  (cond ((null v) :json-null)
        ((eq v t) t)
        ((stringp v) v)
        ((characterp v) (string v))
        ((symbolp v) (concat "#" (symbol-name v)))
        ((listp v) (vconcat (mapcar #'dump--val v)))
        (t (format "%S" v))))
(defun dump--alist (alist) (vconcat (mapcar (lambda (e) (dump--val e)) alist)))
(let ((json-encoding-pretty-print nil))
  (princ (json-encode
          `((command . ,(dump--alist cdlatex-command-alist-default))
            (env . ,(dump--alist cdlatex-env-alist-default))
            (symbol . ,(dump--alist cdlatex-math-symbol-alist-default))
            (modify . ,(dump--alist cdlatex-math-modify-alist-default))))))
