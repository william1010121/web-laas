// 內建預設 snippet：逐條對照 Emacs laas.el（tecosaur/LaTeX-auto-activating-snippets）。
// 語法與使用者設定相同；群組 { group, options, snippets: [...] } 會把 options／sites 傳給裡面的 snippet。
{
  disabledSites: [],
  // 這些網站把 % 視為 LaTeX 註解（影響數學模式判斷）
  latexCommentSites: ["overleaf.com"],

  snippets: [
    {
      group: "laas · 基本符號",
      options: "mA",
      snippets: [
        { trigger: "!=", replacement: "\\neq" },
        { trigger: "!>", replacement: "\\mapsto" },
        { trigger: "**", replacement: "\\cdot" },
        { trigger: "+-", replacement: "\\pm" },
        { trigger: "-+", replacement: "\\mp" },
        { trigger: "->", replacement: "\\to" },
        { trigger: "...", replacement: "\\dots" },
        { trigger: "<<", replacement: "\\ll" },
        { trigger: "<=", replacement: "\\leq" },
        { trigger: "<>", replacement: "\\diamond" },
        { trigger: "=<", replacement: "\\impliedby" },
        { trigger: "==", replacement: "&=", preview: "\\&=" },
        { trigger: "=>", replacement: "\\implies" },
        { trigger: ">=", replacement: "\\geq" },
        { trigger: ">>", replacement: "\\gg" },
        { trigger: "AA", replacement: "\\forall" },
        { trigger: "EE", replacement: "\\exists" },
        { trigger: "cb", replacement: "^3", preview: "x^3" },
        { trigger: "iff", replacement: "\\iff" },
        { trigger: "inn", replacement: "\\in" },
        { trigger: "notin", replacement: "\\not\\in" },
        { trigger: "sr", replacement: "^2", preview: "x^2" },
        { trigger: "xx", replacement: "\\times" },
        { trigger: "|->", replacement: "\\mapsto" },
        { trigger: "|=", replacement: "\\models" },
        { trigger: "||", replacement: "\\mid" },
        { trigger: "~=", replacement: "\\approx" },
        { trigger: "~~", replacement: "\\sim" },
      ],
    },
    {
      group: "laas · 函數與運算子",
      options: "mA",
      snippets: [
        { trigger: "arccos", replacement: "\\arccos" },
        { trigger: "arccot", replacement: "\\arccot", preview: "\\operatorname{arccot}" },
        { trigger: "arccsc", replacement: "\\arccsc", preview: "\\operatorname{arccsc}" },
        { trigger: "arcsec", replacement: "\\arcsec", preview: "\\operatorname{arcsec}" },
        { trigger: "arcsin", replacement: "\\arcsin" },
        { trigger: "arctan", replacement: "\\arctan" },
        { trigger: "cos", replacement: "\\cos" },
        { trigger: "cot", replacement: "\\cot" },
        { trigger: "csc", replacement: "\\csc" },
        { trigger: "exp", replacement: "\\exp" },
        { trigger: "ln", replacement: "\\ln" },
        { trigger: "log", replacement: "\\log" },
        { trigger: "perp", replacement: "\\perp" },
        { trigger: "sin", replacement: "\\sin" },
        { trigger: "tan", replacement: "\\tan" },
        { trigger: "star", replacement: "\\star" },
        { trigger: "gcd", replacement: "\\gcd" },
        { trigger: "min", replacement: "\\min" },
        { trigger: "max", replacement: "\\max" },
        { trigger: "eqv", replacement: "\\equiv" },
      ],
    },
    {
      // laas 輸出 \CC 等巨集（需要在導言區定義）；網頁上的 KaTeX/MathJax 沒有這些巨集，改用 \mathbb{}
      group: "laas · 黑板粗體",
      options: "mA",
      snippets: [
        {
          sites: ["overleaf.com"],
          snippets: [
            { trigger: "CC", replacement: "\\CC", preview: "\\mathbb{C}" },
            { trigger: "FF", replacement: "\\FF", preview: "\\mathbb{F}" },
            { trigger: "HH", replacement: "\\HH", preview: "\\mathbb{H}" },
            { trigger: "NN", replacement: "\\NN", preview: "\\mathbb{N}" },
            { trigger: "PP", replacement: "\\PP", preview: "\\mathbb{P}" },
            { trigger: "QQ", replacement: "\\QQ", preview: "\\mathbb{Q}" },
            { trigger: "RR", replacement: "\\RR", preview: "\\mathbb{R}" },
            { trigger: "ZZ", replacement: "\\ZZ", preview: "\\mathbb{Z}" },
          ],
        },
        {
          excludeSites: ["overleaf.com"],
          snippets: [
            { trigger: "CC", replacement: "\\mathbb{C}" },
            { trigger: "FF", replacement: "\\mathbb{F}" },
            { trigger: "HH", replacement: "\\mathbb{H}" },
            { trigger: "NN", replacement: "\\mathbb{N}" },
            { trigger: "PP", replacement: "\\mathbb{P}" },
            { trigger: "QQ", replacement: "\\mathbb{Q}" },
            { trigger: "RR", replacement: "\\mathbb{R}" },
            { trigger: "ZZ", replacement: "\\mathbb{Z}" },
          ],
        },
      ],
    },
    {
      group: "laas · ; 希臘字母與符號",
      options: "mA",
      snippets: [
        { trigger: ";a", replacement: "\\alpha" },
        { trigger: ";A", replacement: "\\forall" },
        { trigger: ";;A", replacement: "\\aleph" },
        { trigger: ";b", replacement: "\\beta" },
        { trigger: ";;;c", replacement: "\\cos" },
        { trigger: ";;;C", replacement: "\\arccos" },
        { trigger: ";d", replacement: "\\delta" },
        { trigger: ";;d", replacement: "\\partial" },
        { trigger: ";D", replacement: "\\Delta" },
        { trigger: ";;D", replacement: "\\nabla" },
        { trigger: ";e", replacement: "\\epsilon" },
        { trigger: ";;e", replacement: "\\varepsilon" },
        { trigger: ";;;e", replacement: "\\exp" },
        { trigger: ";E", replacement: "\\exists" },
        { trigger: ";;;E", replacement: "\\ln" },
        { trigger: ";f", replacement: "\\phi" },
        { trigger: ";;f", replacement: "\\varphi" },
        { trigger: ";F", replacement: "\\Phi" },
        { trigger: ";g", replacement: "\\gamma" },
        { trigger: ";;;g", replacement: "\\lg" },
        { trigger: ";G", replacement: "\\Gamma" },
        { trigger: ";;;G", replacement: "10^{?}" },
        { trigger: ";h", replacement: "\\eta" },
        { trigger: ";;h", replacement: "\\hbar" },
        { trigger: ";i", replacement: "\\in" },
        { trigger: ";;i", replacement: "\\imath" },
        { trigger: ";I", replacement: "\\iota" },
        { trigger: ";;I", replacement: "\\Im" },
        { trigger: ";;j", replacement: "\\jmath" },
        { trigger: ";k", replacement: "\\kappa" },
        { trigger: ";l", replacement: "\\lambda" },
        { trigger: ";;l", replacement: "\\ell" },
        { trigger: ";;;l", replacement: "\\log" },
        { trigger: ";L", replacement: "\\Lambda" },
        { trigger: ";m", replacement: "\\mu" },
        { trigger: ";n", replacement: "\\nu" },
        { trigger: ";;;n", replacement: "\\ln" },
        { trigger: ";N", replacement: "\\nabla" },
        { trigger: ";;;N", replacement: "\\exp" },
        { trigger: ";o", replacement: "\\omega" },
        { trigger: ";O", replacement: "\\Omega" },
        { trigger: ";;O", replacement: "\\mho" },
        { trigger: ";p", replacement: "\\pi" },
        { trigger: ";;p", replacement: "\\varpi" },
        { trigger: ";P", replacement: "\\Pi" },
        { trigger: ";q", replacement: "\\theta" },
        { trigger: ";;q", replacement: "\\vartheta" },
        { trigger: ";Q", replacement: "\\Theta" },
        { trigger: ";r", replacement: "\\rho" },
        { trigger: ";;r", replacement: "\\varrho" },
        { trigger: ";;R", replacement: "\\Re" },
        { trigger: ";s", replacement: "\\sigma" },
        { trigger: ";;s", replacement: "\\varsigma" },
        { trigger: ";;;s", replacement: "\\sin" },
        { trigger: ";S", replacement: "\\Sigma" },
        { trigger: ";;;S", replacement: "\\arcsin" },
        { trigger: ";t", replacement: "\\tau" },
        { trigger: ";;;t", replacement: "\\tan" },
        { trigger: ";;;T", replacement: "\\arctan" },
        { trigger: ";u", replacement: "\\upsilon" },
        { trigger: ";U", replacement: "\\Upsilon" },
        { trigger: ";v", replacement: "\\vee" },
        { trigger: ";V", replacement: "\\Phi" },
        { trigger: ";w", replacement: "\\xi" },
        { trigger: ";W", replacement: "\\Xi" },
        { trigger: ";x", replacement: "\\chi" },
        { trigger: ";y", replacement: "\\psi" },
        { trigger: ";Y", replacement: "\\Psi" },
        { trigger: ";z", replacement: "\\zeta" },
        { trigger: ";0", replacement: "\\emptyset" },
        { trigger: ";8", replacement: "\\infty" },
        { trigger: ";!", replacement: "\\neg" },
        { trigger: ";^", replacement: "\\uparrow" },
        { trigger: ";&", replacement: "\\wedge" },
        { trigger: ";~", replacement: "\\approx" },
        { trigger: ";;~", replacement: "\\simeq" },
        { trigger: ";_", replacement: "\\downarrow" },
        { trigger: ";+", replacement: "\\cup" },
        { trigger: ";;+", replacement: "\\oplus" },
        { trigger: ";-", replacement: "\\leftrightarrow" },
        { trigger: ";;-", replacement: "\\longleftrightarrow" },
        { trigger: ";*", replacement: "\\times" },
        { trigger: ";/", replacement: "\\not" },
        { trigger: ";|", replacement: "\\mapsto" },
        { trigger: ";;|", replacement: "\\longmapsto" },
        { trigger: ";\\", replacement: "\\setminus" },
        { trigger: ";=", replacement: "\\Leftrightarrow" },
        { trigger: ";;=", replacement: "\\Longleftrightarrow" },
        { trigger: ";(", replacement: "\\langle" },
        { trigger: ";)", replacement: "\\rangle" },
        { trigger: ";[", replacement: "\\Leftarrow" },
        { trigger: ";;[", replacement: "\\Longleftarrow" },
        { trigger: ";]", replacement: "\\Rightarrow" },
        { trigger: ";;]", replacement: "\\Longrightarrow" },
        { trigger: ";{", replacement: "\\subset" },
        { trigger: ";}", replacement: "\\supset" },
        { trigger: ";<", replacement: "\\leftarrow" },
        { trigger: ";;<", replacement: "\\longleftarrow" },
        { trigger: ";;;<", replacement: "\\min" },
        { trigger: ";>", replacement: "\\rightarrow" },
        { trigger: ";;>", replacement: "\\longrightarrow" },
        { trigger: ";;;>", replacement: "\\max" },
        { trigger: ";'", replacement: "\\prime" },
        { trigger: ";.", replacement: "\\cdot" },
      ],
    },
    {
      // laas-subscript-snippets：前面是單一字母時自動下標；已有下標時再打數字會補上大括號
      group: "laas · 自動下標",
      options: "mA",
      snippets: [
        { trigger: /(?<![A-Za-z])([A-Za-z])(\d)/, replacement: "[[0]]_[[1]]", description: "x1 → x_1", preview: "x_1" },
        { trigger: /([_^])([A-Za-z0-9])(\d)/, replacement: "[[0]]{[[1]][[2]]}", description: "x_1 再打 2 → x_{12}", preview: "x_{12}" },
        { trigger: /(?<![A-Za-z])([A-Za-z])([ijkn])\2/, replacement: "[[0]]_[[1]]", description: "xii / xjj / xkk / xnn → x_i", preview: "x_i" },
        { trigger: /([_^])([A-Za-z0-9])([ijkn])\3/, replacement: "[[0]]{[[1]][[2]]}", description: "x_1 再打 ii → x_{1i}", preview: "x_{1i}" },
        { trigger: /(?<![A-Za-z])([A-Za-z])([ijkn])p1/, replacement: "[[0]]_{[[1]]+1}", description: "xip1 → x_{i+1}（j、k、n 同理）", preview: "x_{i+1}" },
        { trigger: /(?<![A-Za-z])([A-Za-z])([ijkn])m1/, replacement: "[[0]]_{[[1]]-1}", description: "xim1 → x_{i-1}（j、k、n 同理）", preview: "x_{i-1}" },
      ],
    },
    {
      // laas-frac-snippet：// 產生空分數；左邊有物件時把它包成分子（外層括號會拿掉）
      group: "laas · 分數",
      options: "mA",
      snippets: [
        { trigger: "//", replacement: "\\frac{$1}{$2}$0" },
        { trigger: "/", replacement: "\\frac{${PREV_INNER}}{$1}$0", options: "mAo", description: "ab/ → \\frac{ab}{}，(a+b)/ → \\frac{a+b}{}" },
      ],
    },
    {
      // laas-accent-snippets：包住左邊的物件
      group: "laas · 重音與字型",
      options: "mAo",
      snippets: [
        { trigger: "'r", replacement: "\\mathrm{${PREV}}" },
        { trigger: "'i", replacement: "\\mathit{${PREV}}" },
        { trigger: "'b", replacement: "\\mathbf{${PREV}}" },
        { trigger: "'e", replacement: "\\mathem{${PREV}}", preview: "\\mathit{x}" },
        { trigger: "'y", replacement: "\\mathtt{${PREV}}" },
        { trigger: "'f", replacement: "\\mathsf{${PREV}}" },
        { trigger: "'.", replacement: "\\dot{${PREV}}" },
        { trigger: "':", replacement: "\\ddot{${PREV}}" },
        { trigger: "'~", replacement: "\\tilde{${PREV}}" },
        { trigger: "'N", replacement: "\\widetilde{${PREV}}" },
        { trigger: "'^", replacement: "\\hat{${PREV}}" },
        { trigger: "'H", replacement: "\\widehat{${PREV}}" },
        { trigger: "'-", replacement: "\\bar{${PREV}}" },
        { trigger: "'T", replacement: "\\overline{${PREV}}" },
        { trigger: "'_", replacement: "\\underline{${PREV}}" },
        { trigger: "'{", replacement: "\\overbrace{${PREV}}" },
        { trigger: "'}", replacement: "\\underbrace{${PREV}}" },
        { trigger: "'>", replacement: "\\vec{${PREV}}" },
        { trigger: "'/", replacement: "\\grave{${PREV}}" },
        { trigger: "'\"", replacement: "\\acute{${PREV}}" },
        { trigger: "'v", replacement: "\\check{${PREV}}" },
        { trigger: "'u", replacement: "\\breve{${PREV}}" },
        { trigger: "'m", replacement: "\\mbox{${PREV}}" },
        { trigger: "'c", replacement: "\\mathcal{${PREV}}" },
        { trigger: "'0", replacement: "{\\textstyle ${PREV}}" },
        { trigger: "'1", replacement: "{\\displaystyle ${PREV}}" },
        { trigger: "'2", replacement: "{\\scriptstyle ${PREV}}" },
        { trigger: "'3", replacement: "{\\scriptscriptstyle ${PREV}}" },
        { trigger: "'q", replacement: "\\sqrt{${PREV}}" },
        { trigger: ".. ", replacement: "\\dot{${PREV}} " },
        { trigger: ",.", replacement: "\\vec{${PREV}}" },
        { trigger: ".,", replacement: "\\vec{${PREV}}" },
        { trigger: "~ ", replacement: "\\tilde{${PREV}} " },
        { trigger: "hat", replacement: "\\hat{${PREV}}" },
        { trigger: "bar", replacement: "\\overline{${PREV}}" },
      ],
    },
    {
      // laas 在 LaTeX 文字模式也能用 'r 'i 'b 'e 'y 'f 'l；網頁上只在 Overleaf 開啟，避免英文縮寫（they'r…）誤觸
      group: "laas · 文字字型（Overleaf）",
      options: "tAo",
      sites: ["overleaf.com"],
      snippets: [
        { trigger: "'r", replacement: "\\textrm{${PREV}}" },
        { trigger: "'i", replacement: "\\textit{${PREV}}" },
        { trigger: "'b", replacement: "\\textbf{${PREV}}" },
        { trigger: "'e", replacement: "\\emph{${PREV}}" },
        { trigger: "'y", replacement: "\\texttt{${PREV}}" },
        { trigger: "'f", replacement: "\\textsf{${PREV}}" },
        { trigger: "'l", replacement: "\\textsl{${PREV}}" },
      ],
    },
  ],
}
