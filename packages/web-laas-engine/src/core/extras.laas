// Web extras: snippets laas.el doesn't have but that are handy on the web (can be turned off in the settings).
// None of them overrides a laas trigger.
{
  snippets: [
    {
      // the web has no Emacs-style $ pairing: mk / dm enter math mode, Tab leaves it
      group: "Web extras · Entering math",
      options: "tAw",
      snippets: [
        { trigger: "mk", replacement: "$$1$$0", description: "Inline math $…$" },
        { trigger: "dm", replacement: "\\[\n$1\n\\]$0", sites: ["overleaf.com"], description: "Display math \\[…\\]" },
        { trigger: "dm", replacement: "$$\n$1\n$$$0", excludeSites: ["overleaf.com"], description: "Display math $$…$$" },
      ],
    },
    {
      group: "Web extras · Structure",
      options: "mA",
      snippets: [
        { trigger: "__", replacement: "_{$1}$0", preview: "x_{\\square}" },
        { trigger: "td", replacement: "^{$1}$0", preview: "x^{\\square}" },
        { trigger: "ee", replacement: "e^{$1}$0" },
        { trigger: "invs", replacement: "^{-1}", preview: "x^{-1}" },
        { trigger: "sq", replacement: "\\sqrt{$1}$0" },
        { trigger: "conj", replacement: "\\overline{$1}$0" },
        { trigger: "tt", replacement: "\\text{$1}$0", preview: "\\text{text}" },
        { trigger: "set", replacement: "\\{ $1 \\}$0" },
        { trigger: "norm", replacement: "\\| $1 \\|$0" },
        { trigger: "abs", replacement: "\\left| $1 \\right|$0" },
        { trigger: "lr(", replacement: "\\left( $1 \\right)$0" },
        { trigger: "lr[", replacement: "\\left[ $1 \\right]$0" },
        { trigger: "lr{", replacement: "\\left\\{ $1 \\right\\}$0" },
        { trigger: "ceil", replacement: "\\lceil $1 \\rceil$0" },
        { trigger: "floor", replacement: "\\lfloor $1 \\rfloor$0" },
        { trigger: "part", replacement: "\\frac{\\partial $1}{\\partial $2}$0" },
        { trigger: "sum", replacement: "\\sum_{$1}^{$2} $0" },
        { trigger: "prod", replacement: "\\prod_{$1}^{$2} $0" },
        { trigger: "lim", replacement: "\\lim_{${1:n} \\to ${2:\\infty}} $0" },
        { trigger: "int", replacement: "\\int_{$1}^{$2} $0" },
        { trigger: "bmat", replacement: "\\begin{bmatrix} $1 \\end{bmatrix}$0", preview: "\\begin{bmatrix} a & b \\\\ c & d \\end{bmatrix}" },
        { trigger: "pmat", replacement: "\\begin{pmatrix} $1 \\end{pmatrix}$0", preview: "\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}" },
        { trigger: "case", replacement: "\\begin{cases} $1 \\end{cases}$0", preview: "\\begin{cases} a & x>0 \\\\ b & x \\le 0 \\end{cases}" },
      ],
    },
  ],
}
