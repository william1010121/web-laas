// cdlatex（Carsten Dominik）的預設表，由 scripts/gen-cdlatex.mjs 從 cdlatex.el 產生，請勿手動修改。
// 文件類指令與文字模式的 ' ` 只在 Overleaf 開啟（其他網站的一般文字會誤觸）。
// 未移植（需要 reftex／互動輸入）：pref、ref、lbl、cte、cite{、beg、env
{
  snippets: [
    {
      group: "cdlatex · ` 數學符號",
      options: "mA",
      snippets: [
        { trigger: "`a", replacement: "\\alpha" },
        { trigger: "`A", replacement: "\\forall" },
        { trigger: "``A", replacement: "\\aleph", description: "第 2 層" },
        { trigger: "`b", replacement: "\\beta" },
        { trigger: "```c", replacement: "\\cos", description: "第 3 層" },
        { trigger: "```C", replacement: "\\arccos", description: "第 3 層" },
        { trigger: "`d", replacement: "\\delta" },
        { trigger: "``d", replacement: "\\partial", description: "第 2 層" },
        { trigger: "`D", replacement: "\\Delta" },
        { trigger: "``D", replacement: "\\nabla", description: "第 2 層" },
        { trigger: "`e", replacement: "\\epsilon" },
        { trigger: "``e", replacement: "\\varepsilon", description: "第 2 層" },
        { trigger: "```e", replacement: "\\exp", description: "第 3 層" },
        { trigger: "`E", replacement: "\\exists" },
        { trigger: "```E", replacement: "\\ln", description: "第 3 層" },
        { trigger: "`f", replacement: "\\phi" },
        { trigger: "``f", replacement: "\\varphi", description: "第 2 層" },
        { trigger: "`F", replacement: "\\Phi" },
        { trigger: "`g", replacement: "\\gamma" },
        { trigger: "```g", replacement: "\\lg", description: "第 3 層" },
        { trigger: "`G", replacement: "\\Gamma" },
        { trigger: "```G", replacement: "10^{$0}", description: "第 3 層" },
        { trigger: "`h", replacement: "\\eta" },
        { trigger: "``h", replacement: "\\hbar", description: "第 2 層" },
        { trigger: "`i", replacement: "\\in" },
        { trigger: "``i", replacement: "\\imath", description: "第 2 層" },
        { trigger: "``I", replacement: "\\Im", description: "第 2 層" },
        { trigger: "``j", replacement: "\\jmath", description: "第 2 層" },
        { trigger: "`k", replacement: "\\kappa" },
        { trigger: "`l", replacement: "\\lambda" },
        { trigger: "``l", replacement: "\\ell", description: "第 2 層" },
        { trigger: "```l", replacement: "\\log", description: "第 3 層" },
        { trigger: "`L", replacement: "\\Lambda" },
        { trigger: "`m", replacement: "\\mu" },
        { trigger: "`n", replacement: "\\nu" },
        { trigger: "```n", replacement: "\\ln", description: "第 3 層" },
        { trigger: "`N", replacement: "\\nabla" },
        { trigger: "```N", replacement: "\\exp", description: "第 3 層" },
        { trigger: "`o", replacement: "\\omega" },
        { trigger: "`O", replacement: "\\Omega" },
        { trigger: "``O", replacement: "\\mho", description: "第 2 層" },
        { trigger: "`p", replacement: "\\pi" },
        { trigger: "``p", replacement: "\\varpi", description: "第 2 層" },
        { trigger: "`P", replacement: "\\Pi" },
        { trigger: "`q", replacement: "\\theta" },
        { trigger: "``q", replacement: "\\vartheta", description: "第 2 層" },
        { trigger: "`Q", replacement: "\\Theta" },
        { trigger: "`r", replacement: "\\rho" },
        { trigger: "``r", replacement: "\\varrho", description: "第 2 層" },
        { trigger: "``R", replacement: "\\Re", description: "第 2 層" },
        { trigger: "`s", replacement: "\\sigma" },
        { trigger: "``s", replacement: "\\varsigma", description: "第 2 層" },
        { trigger: "```s", replacement: "\\sin", description: "第 3 層" },
        { trigger: "`S", replacement: "\\Sigma" },
        { trigger: "```S", replacement: "\\arcsin", description: "第 3 層" },
        { trigger: "`t", replacement: "\\tau" },
        { trigger: "```t", replacement: "\\tan", description: "第 3 層" },
        { trigger: "```T", replacement: "\\arctan", description: "第 3 層" },
        { trigger: "`u", replacement: "\\upsilon" },
        { trigger: "`U", replacement: "\\Upsilon" },
        { trigger: "`v", replacement: "\\vee" },
        { trigger: "`w", replacement: "\\xi" },
        { trigger: "`W", replacement: "\\Xi" },
        { trigger: "`x", replacement: "\\chi" },
        { trigger: "`y", replacement: "\\psi" },
        { trigger: "`Y", replacement: "\\Psi" },
        { trigger: "`z", replacement: "\\zeta" },
        { trigger: "`0", replacement: "\\emptyset" },
        { trigger: "`8", replacement: "\\infty" },
        { trigger: "`!", replacement: "\\neg" },
        { trigger: "`^", replacement: "\\uparrow" },
        { trigger: "`&", replacement: "\\wedge" },
        { trigger: "`~", replacement: "\\approx" },
        { trigger: "``~", replacement: "\\simeq", description: "第 2 層" },
        { trigger: "`_", replacement: "\\downarrow" },
        { trigger: "`+", replacement: "\\cup" },
        { trigger: "`-", replacement: "\\leftrightarrow" },
        { trigger: "``-", replacement: "\\longleftrightarrow", description: "第 2 層" },
        { trigger: "`*", replacement: "\\times" },
        { trigger: "`/", replacement: "\\not" },
        { trigger: "`|", replacement: "\\mapsto" },
        { trigger: "``|", replacement: "\\longmapsto", description: "第 2 層" },
        { trigger: "`\\", replacement: "\\setminus" },
        { trigger: "`=", replacement: "\\Leftrightarrow" },
        { trigger: "``=", replacement: "\\Longleftrightarrow", description: "第 2 層" },
        { trigger: "`(", replacement: "\\langle" },
        { trigger: "`)", replacement: "\\rangle" },
        { trigger: "`[", replacement: "\\Leftarrow" },
        { trigger: "``[", replacement: "\\Longleftarrow", description: "第 2 層" },
        { trigger: "`]", replacement: "\\Rightarrow" },
        { trigger: "``]", replacement: "\\Longrightarrow", description: "第 2 層" },
        { trigger: "`{", replacement: "\\subset" },
        { trigger: "`}", replacement: "\\supset" },
        { trigger: "`<", replacement: "\\leftarrow" },
        { trigger: "``<", replacement: "\\longleftarrow", description: "第 2 層" },
        { trigger: "```<", replacement: "\\min", description: "第 3 層" },
        { trigger: "`>", replacement: "\\rightarrow" },
        { trigger: "``>", replacement: "\\longrightarrow", description: "第 2 層" },
        { trigger: "```>", replacement: "\\max", description: "第 3 層" },
        { trigger: "`'", replacement: "\\prime" },
        { trigger: "`.", replacement: "\\cdot" },
      ],
    },
    {
      group: "cdlatex · ' 修飾（重音、字型）",
      options: "mA",
      snippets: [
        { trigger: "'.", action: "cdlatex-modify", command: "\\dot", accent: true, rmdot: true },
        { trigger: "':", action: "cdlatex-modify", command: "\\ddot", accent: true, rmdot: true },
        { trigger: "'~", action: "cdlatex-modify", command: "\\tilde", accent: true, rmdot: true },
        { trigger: "'N", action: "cdlatex-modify", command: "\\widetilde", accent: true, rmdot: true },
        { trigger: "'o", action: "cdlatex-modify", command: "\\mathring", accent: true, rmdot: true },
        { trigger: "'^", action: "cdlatex-modify", command: "\\hat", accent: true, rmdot: true },
        { trigger: "'H", action: "cdlatex-modify", command: "\\widehat", accent: true, rmdot: true },
        { trigger: "'-", action: "cdlatex-modify", command: "\\bar", accent: true, rmdot: true },
        { trigger: "'T", action: "cdlatex-modify", command: "\\overline", accent: true, rmdot: false },
        { trigger: "'_", action: "cdlatex-modify", command: "\\underline", accent: true, rmdot: false },
        { trigger: "']", action: "cdlatex-modify", command: "\\overbrace", accent: true, rmdot: false },
        { trigger: "'}", action: "cdlatex-modify", command: "\\underbrace", accent: true, rmdot: false },
        { trigger: "'>", action: "cdlatex-modify", command: "\\vec", accent: true, rmdot: true },
        { trigger: "'/", action: "cdlatex-modify", command: "\\grave", accent: true, rmdot: true },
        { trigger: "'\\", action: "cdlatex-modify", command: "\\acute", accent: true, rmdot: true },
        { trigger: "'v", action: "cdlatex-modify", command: "\\check", accent: true, rmdot: true },
        { trigger: "'u", action: "cdlatex-modify", command: "\\breve", accent: true, rmdot: true },
        { trigger: "'m", action: "cdlatex-modify", command: "\\mbox", accent: true, rmdot: false },
        { trigger: "'t", action: "cdlatex-modify", command: "\\text", accent: true, rmdot: false },
        { trigger: "'c", action: "cdlatex-modify", command: "\\mathcal", accent: true, rmdot: false },
        { trigger: "'r", action: "cdlatex-modify", command: "\\mathrm", accent: true, rmdot: false },
        { trigger: "'i", action: "cdlatex-modify", command: "\\mathit", accent: true, rmdot: false },
        { trigger: "'b", action: "cdlatex-modify", command: "\\mathbf", accent: true, rmdot: false },
        { trigger: "'e", action: "cdlatex-modify", command: "\\mathem", accent: true, rmdot: false },
        { trigger: "'y", action: "cdlatex-modify", command: "\\mathtt", accent: true, rmdot: false },
        { trigger: "'f", action: "cdlatex-modify", command: "\\mathsf", accent: true, rmdot: false },
        { trigger: "'F", action: "cdlatex-modify", command: "\\mathfrak", accent: true, rmdot: false },
        { trigger: "'0", action: "cdlatex-modify", command: "\\textstyle", accent: false, rmdot: false },
        { trigger: "'1", action: "cdlatex-modify", command: "\\displaystyle", accent: false, rmdot: false },
        { trigger: "'2", action: "cdlatex-modify", command: "\\scriptstyle", accent: false, rmdot: false },
        { trigger: "'3", action: "cdlatex-modify", command: "\\scriptscriptstyle", accent: false, rmdot: false },
        { trigger: "'(", action: "cdlatex-modify", command: "\\left( ? \\right)", accent: false, rmdot: false },
        { trigger: "'[", action: "cdlatex-modify", command: "\\left[ ? \\right]", accent: false, rmdot: false },
        { trigger: "'{", action: "cdlatex-modify", command: "\\left\\{ ? \\right\\}", accent: false, rmdot: false },
        { trigger: "'<", action: "cdlatex-modify", command: "\\left< ? \\right>", accent: false, rmdot: false },
        { trigger: "'|", action: "cdlatex-modify", command: "\\left| ? \\right|", accent: false, rmdot: false },
      ],
    },
    {
      group: "cdlatex · _ ^ 上下標",
      options: "mA",
      snippets: [
        { trigger: "_", replacement: "_{$0}", preview: "x_{\\square}" },
        { trigger: "^", replacement: "^{$0}", preview: "x^{\\square}" },
        { trigger: "_{_", replacement: "_{\\mathrm{$0}", preview: "x_{\\mathrm{a}}", description: "連按兩次 _ → 正體下標" },
        { trigger: "^{^", replacement: "^{\\mathrm{$0}", preview: "x^{\\mathrm{a}}", description: "連按兩次 ^ → 正體上標" },
      ],
    },
    {
      group: "cdlatex · Tab 指令（數學）",
      options: "mw",
      snippets: [
        { trigger: "spl", replacement: "\\begin{split}\n$0\n\\end{split}", description: "Insert SPLIT environment template" },
        { trigger: "lr(", replacement: "\\left( $0 \\right)", description: "Insert a \\left( \\right) pair" },
        { trigger: "lr[", replacement: "\\left[ $0 \\right]", description: "Insert a \\left[ \\right] pair" },
        { trigger: "lr{", replacement: "\\left\\{ $0 \\right\\}", description: "Insert a \\left{ \\right} pair" },
        { trigger: "lr<", replacement: "\\left\\langle $0 \\right\\rangle", description: "Insert a \\left\\langle \\right\\rangle pair" },
        { trigger: "lr|", replacement: "\\left| $0 \\right|", description: "Insert a \\left| \\right| pair" },
        { trigger: "caseeq", replacement: "\\left\\{ \n\\begin{array}{l@{\\quad:\\quad}l}\n$0 & \\\\\n & \n\\end{array}\\right.", description: "Insert a = { construct" },
        { trigger: "fr", replacement: "\\frac{$0}{}", description: "Insert \\frac{}{}" },
        { trigger: "sq", replacement: "\\sqrt{$0}", description: "Insert \\sqrt{}" },
        { trigger: "intl", replacement: "\\int\\limits_{$0}^{}", description: "Insert \\int\\limits_{}^{}" },
        { trigger: "suml", replacement: "\\sum\\limits_{$0}^{}", description: "Insert \\sum\\limits_{}^{}" },
        { trigger: "nonum", replacement: "\\nonumber\\\\\n$0", description: "Insert \\nonumber\\\\" },
        { trigger: "qq", replacement: "\\quad$0", description: "Insert \\quad" },
        { trigger: "qqq", replacement: "\\qquad$0", description: "Insert \\qquad" },
      ],
    },
    {
      group: "cdlatex · Tab 指令（文件）",
      options: "tw",
      sites: ["overleaf.com"],
      snippets: [
        { trigger: "ct", replacement: "\\cite{$0}", description: "Insert \\cite" },
        { trigger: "it", replacement: "\\item $0", description: "New item in current environment" },
        { trigger: "ite", replacement: "\\begin{itemize}\n\\item $0\n\\end{itemize}", description: "Insert an ITEMIZE environment template" },
        { trigger: "enu", replacement: "\\begin{enumerate}\n\\item$0\n\\end{enumerate}", description: "Insert an ENUMERATE environment template" },
        { trigger: "equ", replacement: "\\begin{equation}\n$0\n\\end{equation}", description: "Insert an EQUATION environment template" },
        { trigger: "eq*", replacement: "\\begin{equation*}\n$0\n\\end{equation*}", description: "Insert an EQUATION* environment template" },
        { trigger: "eqn", replacement: "\\begin{eqnarray}\n$0 &  & \\\\\n\\end{eqnarray}", description: "Insert an EQNARRAY environment template" },
        { trigger: "ali", replacement: "\\begin{align}\n$0\n\\end{align}", description: "Insert an ALIGN environment template" },
        { trigger: "ali*", replacement: "\\begin{align*}\n$0\n\\end{align*}", description: "Insert an ALIGN* environment template" },
        { trigger: "alit", replacement: "\\begin{alignat}{$0}\n\n\\end{alignat}", description: "Insert an ALIGNAT environment template" },
        { trigger: "alit*", replacement: "\\begin{alignat*}{$0}\n\n\\end{alignat*}", description: "Insert an ALIGNAT* environment template" },
        { trigger: "xal", replacement: "\\begin{xalignat}{$0}\n\n\\end{xalignat}", description: "Insert a XALIGNAT environment template" },
        { trigger: "xal*", replacement: "\\begin{xalignat*}{$0}\n\n\\end{xalignat*}", description: "Insert a XALIGNAT* environment template" },
        { trigger: "xxa", replacement: "\\begin{xxalignat}{$0}\n\n\\end{xxalignat}", description: "Insert a XXALIGNAT environment template" },
        { trigger: "xxa*", replacement: "\\begin{xxalignat}{$0}\n\n\\end{xxalignat}", description: "Insert a XXALIGNAT environment template" },
        { trigger: "mul", replacement: "\\begin{multline}\n$0\n\\end{multline}", description: "Insert a MULTINE environment template" },
        { trigger: "mul*", replacement: "\\begin{multline*}\n$0\n\\end{multline*}", description: "Insert a MULTINE* environment template" },
        { trigger: "gat", replacement: "\\begin{gather}\n$0\n\\end{gather}", description: "Insert a GATHER environment template" },
        { trigger: "gat*", replacement: "\\begin{gather*}\n$0\n\\end{gather*}", description: "Insert a GATHER* environment template" },
        { trigger: "fla", replacement: "\\begin{flalign}\n$0\n\\end{flalign}", description: "Insert a FLALIGN environment template" },
        { trigger: "fla*", replacement: "\\begin{flalign*}\n$0\n\\end{flalign*}", description: "Insert a FLALIGN* environment template" },
        { trigger: "fg", replacement: "\\begin{figure}[htbp]\n\\centerline{\\includegraphics[]{}}\n\\caption[]{$0}\n\\end{figure}", description: "Insert a FIGURE environment template" },
        { trigger: "sn", replacement: "\\section{$0}", description: "Insert a \\section{} statement" },
        { trigger: "ss", replacement: "\\subsection{$0}", description: "Insert a \\subsection{} statement" },
        { trigger: "sss", replacement: "\\subsubsection{$0}", description: "Insert a \\subsubsection{} statement" },
        { trigger: "pf", replacement: "\\paragraph{$0}", description: "Insert a \\paragraph{} statement" },
        { trigger: "sp", replacement: "\\subparagraph{$0}", description: "Insert a \\subparagraph{} statement" },
        { trigger: "ssp", replacement: "\\subsubparagraph{$0}", description: "Insert a \\subsubparagraph{} statement" },
        { trigger: "cl", replacement: "\\centerline{$0}", description: "Insert \\centerline" },
        { trigger: "inc", replacement: "\\includegraphics[]{$0}", description: "Insert \\includegraphics with file name" },
        { trigger: "fn", replacement: "\\footnote{$0}", description: "Make a footnote" },
        { trigger: "qq", replacement: "\\quad$0", description: "Insert \\quad" },
        { trigger: "qqq", replacement: "\\qquad$0", description: "Insert \\qquad" },
      ],
    },
    {
      group: "cdlatex · ' 修飾（文字模式）",
      options: "tA",
      sites: ["overleaf.com"],
      snippets: [
        { trigger: "'r", action: "cdlatex-modify", command: "\\textrm", accent: true, rmdot: false },
        { trigger: "'i", action: "cdlatex-modify", command: "\\textit", accent: true, rmdot: false },
        { trigger: "'l", action: "cdlatex-modify", command: "\\textsl", accent: true, rmdot: false },
        { trigger: "'b", action: "cdlatex-modify", command: "\\textbf", accent: true, rmdot: false },
        { trigger: "'e", action: "cdlatex-modify", command: "\\emph", accent: true, rmdot: false },
        { trigger: "'y", action: "cdlatex-modify", command: "\\texttt", accent: true, rmdot: false },
        { trigger: "'f", action: "cdlatex-modify", command: "\\textsf", accent: true, rmdot: false },
      ],
    },
