// 我的 LaTeX snippet 設定（語法：JavaScript 物件字面值，可以寫註解）
// 行為開關（Tab、自動空白、Web 擴充…）在「一般」頁面設定。
{
  // true：在內建 snippet（laas + Web 擴充）之上加入／覆寫；false：只用下面自己寫的
  useDefaults: true,

  // 不想要的內建 snippet，填 trigger（字串或 /regex/）
  removeDefaults: [
    // "**",
  ],

  // 在這些網站完全停用（包含子網域）
  disabledSites: [
    // "mail.google.com",
  ],

  // 可以在 regex trigger 裡用 ${NAME} 引用
  variables: {},

  snippets: [
    // 群組：名稱會顯示在 cheat sheet；options 會傳給裡面每個 snippet
    // {
    //   group: "我的常用",
    //   options: "mA",
    //   snippets: [
    //     { trigger: "qq", replacement: `\quad` },
    //     { trigger: "EE", replacement: `\mathbb{E}`, description: "期望值" },
    //   ],
    // },

    // 文字模式自動展開；`…` 是 raw string，不用把反斜線寫兩次
    // { trigger: "beg", replacement: `\begin{$1}
    // 	$0
    // \end{$1}`, options: "tA" },

    // 數學模式、Tab 才展開（沒有 A）
    // { trigger: "mat", replacement: `\begin{matrix} $1 \end{matrix}$0`, options: "m" },

    // regex：[[0]] 是第一個括號群組
    // { trigger: /([a-zA-Z])tld/, replacement: `\tilde{[[0]]}`, options: "mA", description: "xtld → \\tilde{x}" },

    // 作用在左邊物件上：x'o → \operatorname{x}
    // { trigger: "'o", replacement: `\operatorname{${PREV}}`, options: "mAo" },
  ],
}
