// My LaTeX snippet config (syntax: a JavaScript object literal; comments allowed)
// Behaviour switches (Tab, automatic space, Web extras…) are on the General page.
{
  // true: add to / override the built-in snippets (laas + Web extras); false: only the ones below
  useDefaults: true,

  // built-in snippets you don't want, by trigger (a string or /regex/)
  removeDefaults: [
    // "**",
  ],

  // fully off on these sites (subdomains included)
  disabledSites: [
    // "mail.google.com",
  ],

  // usable as ${NAME} in regex triggers
  variables: {},

  snippets: [
    // a group: its name shows in the cheat sheet; its options pass to every snippet inside
    // {
    //   group: "My favourites",
    //   options: "mA",
    //   snippets: [
    //     { trigger: "qq", replacement: `\quad` },
    //     { trigger: "EE", replacement: `\mathbb{E}`, description: "expectation" },
    //   ],
    // },

    // auto-expands in text mode; `…` is a raw string, so backslashes aren't doubled
    // { trigger: "beg", replacement: `\begin{$1}
    // 	$0
    // \end{$1}`, options: "tA" },

    // in text, on Tab: this site's display math ($$…$$, \[…\]… as dm inserts), the caret inside
    // { trigger: "eq", replacement: "$1", math: "display", options: "t" },

    // math mode, expands on Tab (no A)
    // { trigger: "mat", replacement: `\begin{matrix} $1 \end{matrix}$0`, options: "m" },

    // regex: [[0]] is the first capture group
    // { trigger: /([a-zA-Z])tld/, replacement: `\tilde{[[0]]}`, options: "mA", description: "xtld → \\tilde{x}" },

    // acts on the object to the left: x'o → \operatorname{x}
    // { trigger: "'o", replacement: `\operatorname{${PREV}}`, options: "mAo" },
  ],
}
